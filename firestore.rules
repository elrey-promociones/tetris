rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /counters/{counterId} {
      allow read: if isValidId(counterId);
      allow create: if isValidId(counterId)
                    && request.resource.data.currentNumber is number
                    && request.resource.data.currentNumber >= 0;
      allow update: if isValidId(counterId)
                    && request.resource.data.currentNumber is number
                    && request.resource.data.currentNumber >= resource.data.currentNumber;
    }

    match /users/{userId} {
      allow read: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
                    && request.resource.data.sequenceNumber is number
                    && request.resource.data.userCode is string
                    && request.resource.data.userCode.size() <= 32
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() >= 1
                    && request.resource.data.nickname.size() <= 30;
      allow update: if isValidId(userId)
                    && request.resource.data.sequenceNumber == resource.data.sequenceNumber
                    && request.resource.data.userCode == resource.data.userCode;
      allow delete: if false;
    }

    match /game_records/{recordId} {
      allow read, list: if true;
      allow create: if isValidId(recordId)
                    && request.resource.data.userCode is string
                    && request.resource.data.nickname is string
                    && request.resource.data.score is number
                    && request.resource.data.lines is number
                    && request.resource.data.fichas is number;
      allow update, delete: if false;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
